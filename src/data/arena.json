{
  "_about": "Arena (systems/ArenaRunner.js): an endless gauntlet, fighting only. Team select (scenes/ArenaTeamScene.js) picks 2 heroes + 1 support from `roster`. HP carries over between fights; the enemies get stronger every fight (`scaling`); the bundle comes from the `tiers` entry whose `fromFight` was reached last (the last tier repeats forever). After every win: the level card (`levels`, separate from levels.json so the story balance is untouched), then pick 1 of 3 `buffs`. After every `campfire.every` wins: the campfire heals everyone (downed heroes too) and offers 1 of 3 `campfire.upgrades`. A team wipe ends the run (scenes/ArenaEndScene.js). Per run only: nothing is saved.",

  "roster": {
    "heroes": [
      {
        "id": "rhea",
        "portrait": "rhea_determined",
        "role": "Fast · Damage",
        "color": "#3fd0c9",
        "path": "Lv 4 Return to Sender · Lv 10 Recollection"
      },
      {
        "id": "dov",
        "portrait": "dov_fierce",
        "role": "Tank · Heals",
        "color": "#e0a040",
        "path": "Lv 2 Anchor · Lv 6 Brace"
      },
      { "id": null, "locked": true }
    ],
    "supports": [
      {
        "id": "nala",
        "portrait": "nala_calm",
        "name": "Nala",
        "role": "Support · Hollow sense",
        "color": "#e8883a",
        "text": "Tap her while a Hollow winds up to cancel its attack. Her Glow lets Strikes hit Hollows."
      },
      { "id": null, "locked": true }
    ]
  },

  "heroCount": 2,
  "supportCount": 1,

  "scaling": {
    "_about": "Fight n (1-based): enemy HP x (1 + hpPerFight x (n-1)), damage x (1 + dmgPerFight x (n-1)), telegraph x max(telegraphMin, 1 - telegraphPerFight x (n-1)). On top of the chosen difficulty; byDifficulty.<id> overrides any of them (Story's half damage would otherwise never end a run).",
    "hpPerFight": 0.1,
    "dmgPerFight": 0.16,
    "telegraphPerFight": 0.01,
    "telegraphMin": 0.8,
    "byDifficulty": {
      "story": { "dmgPerFight": 0.5 }
    }
  },

  "_heal": "Every standing hero heals this share of max HP after each win (before the buffs' healAfterFightPct).",
