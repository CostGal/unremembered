{
  "_doc": [
    "Procedural music (systems/Music.js). Used when public/assets/audio/music/<key>.mp3 does not exist.",
    "Grid: 16 steps per bar (16th notes), 4/4. A track = bpm + key + scale + layers + patterns + sections + form.",
    "Chords are roman numerals relative to the root: lower case = minor, UPPER = major, b/# prefix, suffix 7 | M7 | 9 | dim | sus2 | sus4. Warm variant: minor i/iv/v become major.",
    "Pattern = list of bars (cycled by bar-in-section), each bar 16 space-separated tokens, '-' = empty bar.",
    "  chord mode : r 3 5 7 = chord tone, R T F S = same one octave up; ! accent, ~ soft; '.' rest",
    "  scale mode : 1-7 = scale degree; ' = octave up, , = octave down; ! accent, ~ soft",
    "  drum mode  : x normal, X accent, o ghost",
    "layer.range = [min,max] intensity window; layer.warm = 'only' | 'off'. section.use maps layer id -> pattern name | true | level."
  ],

  "engine": {
    "lookaheadMs": 600,
    "tickMs": 40,
    "maxVoices": 22,
    "humanizeMs": 5,
    "snapAvoidNotes": true,
    "gain": 0.9,
    "intensitySlewPerSec": 1.2,
    "warmSlewPerSec": 2.5,
    "warmFilterMult": 1.9,
    "reverb": { "enabled": true, "seconds": 1.2, "decay": 2.8, "darken": 0.6 },
    "delay": { "enabled": true, "beats": 0.75, "feedback": 0.32, "lowpassHz": 2400 },
    "rainBuffer": { "seconds": 4 },
    "noiseBuffer": { "seconds": 2 }
  },

  "scales": {
    "minor": [0, 2, 3, 5, 7, 8, 10],
    "harmonicMinor": [0, 2, 3, 5, 7, 8, 11],
    "major": [0, 2, 4, 5, 7, 9, 11],
    "dorian": [0, 2, 3, 5, 7, 9, 10]
  },

  "instruments": {
