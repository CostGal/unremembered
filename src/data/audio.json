{
  "music": {
    "dir": "assets/audio/music/",
    "ext": ".mp3",
    "crossfadeMs": 500,
    "scenes": { "Menu": "title", "Cutscene": "cutscene", "Dialogue": "cutscene", "End": "ending" },
    "prefetch": ["title", "cutscene", "battle", "boss", "ending"]
  },
  "master": { "threshold": -6, "knee": 8, "ratio": 10, "attack": 0.004, "release": 0.18 },
  "blip": { "minGapMs": 35, "attackMs": 2 },
  "sfx": {
    "hit": [
      { "type": "noise", "ms": 90, "gain": 0.35, "filterHz": 1800 },
      { "type": "osc", "wave": "square", "from": 180, "to": 60, "ms": 90, "gain": 0.15 }
    ],
    "perfect": [
      { "type": "osc", "wave": "triangle", "from": 880, "to": 1760, "ms": 120, "gain": 0.3 },
      { "type": "osc", "wave": "sine", "from": 1320, "to": 1320, "ms": 240, "gain": 0.2, "delayMs": 60 }
    ],
    "good": [{ "type": "osc", "wave": "triangle", "from": 660, "to": 880, "ms": 110, "gain": 0.25 }],
    "miss": [
      { "type": "osc", "wave": "sawtooth", "from": 220, "to": 90, "ms": 180, "gain": 0.15 },
      { "type": "noise", "ms": 120, "gain": 0.2, "filterHz": 800 }
    ],
    "menu": [{ "type": "osc", "wave": "square", "from": 520, "to": 520, "ms": 40, "gain": 0.08 }],
    "echo": [{ "type": "osc", "wave": "sine", "from": 990, "to": 1480, "ms": 90, "gain": 0.12 }],
    "victory": [
      { "type": "osc", "wave": "triangle", "from": 523, "to": 523, "ms": 140, "gain": 0.22 },
      { "type": "osc", "wave": "triangle", "from": 659, "to": 659, "ms": 140, "gain": 0.22, "delayMs": 110 },
      { "type": "osc", "wave": "triangle", "from": 784, "to": 784, "ms": 160, "gain": 0.22, "delayMs": 220 },
      { "type": "osc", "wave": "sine", "from": 1047, "to": 1047, "ms": 420, "gain": 0.2, "delayMs": 330 }
    ],
    "ultimate": [
      { "type": "osc", "wave": "sine", "from": 220, "to": 880, "ms": 700, "gain": 0.3 },
      { "type": "osc", "wave": "triangle", "from": 330, "to": 1320, "ms": 700, "gain": 0.15, "delayMs": 80 }
    ],
    "stamp": [
      { "type": "noise", "ms": 120, "gain": 0.45, "filterHz": 500 },
      { "type": "osc", "wave": "sine", "from": 140, "to": 45, "ms": 200, "gain": 0.5 }
    ],
    "thunder": [
      { "type": "noise", "ms": 1900, "gain": 0.5, "filterHz": 220 },
      { "type": "noise", "ms": 700, "gain": 0.22, "filterHz": 650 },
      { "type": "noise", "ms": 1500, "gain": 0.3, "filterHz": 180, "delayMs": 350 },
      { "type": "osc", "wave": "sine", "from": 75, "to": 32, "ms": 1700, "gain": 0.3 }
    ],
    "break": [
      { "type": "noise", "ms": 220, "gain": 0.4, "filterHz": 900 },
      { "type": "osc", "wave": "square", "from": 520, "to": 90, "ms": 260, "gain": 0.2 },
      { "type": "osc", "wave": "triangle", "from": 880, "to": 440, "ms": 200, "gain": 0.12, "delayMs": 60 }
    ]
  }
}
