        "from": "beat",
        "before": 2200,
        "after": 2600
      },
      "fadeOut": 400
    },
    {
      "id": "title",
      "kind": "title",
      "url": "",
      "seed": 9,
      "stop": {
        "marker": "ready",
        "after": 2800
      },
      "cut": {
        "from": "ready",
        "before": 0,
        "after": 2000
      },
      "fadeIn": 300
    },
    {
      "id": "end_card",
      "kind": "card",
      "durationMs": 3500,
      "logo": true,
      "lines": [
        "Play it in your phone browser",
        "costgal.github.io/unremembered",
        "Made in one week for a game jam"
      ],
      "fadeIn": 300,
      "fadeOut": 600
    }
  ]
}
